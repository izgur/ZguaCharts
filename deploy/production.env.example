# Copy to ignored .env.production or set these privately in Render Environment.
# Production project: zguachartsdb / cool-tree-27722416. Never use dev URLs here.
ZGUA_ENV=production
ZGUA_NEON_PROJECT_ID=cool-tree-27722416
DATABASE_URL=
DATABASE_URL_UNPOOLED=
ACCOUNT_MFA_KEY=
PUBLIC_APP_URL=https://zguacharts.onrender.com
ZGUA_PUBLIC_ACCOUNTS=1
# Keep registrations closed until a verified sender domain is configured.
ZGUA_REGISTRATION_ENABLED=0
ZGUA_MAIL_PROVIDER=resend
RESEND_API_KEY=
ZGUA_MAIL_FROM=
ZGUA_MAIL_DOMAIN_VERIFIED=0
ZGUA_MAIL_TEST_RECIPIENT=
ZGUA_CACHE_CANDLE_BUDGET=60000
NODE_OPTIONS=--max-old-space-size=128
